{
  "name": "@lanhu-context/core",
  "version": "0.3.2",
  "type": "module",
  "description": "Core logic for lanhu-context: URL parsing, Lanhu API client, schema-to-HTML transforms, design tokens, and context pipeline",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaYePython/lanhu-context.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "css-to-tailwindcss": "^1.0.5",
    "css-to-tailwindcss4": "^0.0.3",
    "ofetch": "^1.4.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.4"
  }
}
